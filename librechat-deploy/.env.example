# SHAVI AI on LibreChat — environment template (no real secrets here).
# Copy to .env and fill every CHANGE_ME value. .env must never be committed.
#
# Generate secrets:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   # CREDS_KEY / JWT_*
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"   # CREDS_IV
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" # MEILI_MASTER_KEY

# ---------- server ----------
HOST=0.0.0.0
PORT=3080
APP_TITLE=SHAVI AI
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# ---------- database ----------
MONGO_URI=mongodb://mongodb:27017/LibreChat

# ---------- secrets (CHANGE_ME) ----------
CREDS_KEY=CHANGE_ME_64_HEX_CHARS
CREDS_IV=CHANGE_ME_32_HEX_CHARS
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_64_HEX_CHARS
MEILI_MASTER_KEY=CHANGE_ME_BASE64
MEILI_HOST=http://meilisearch:7700

# ---------- AI provider (NVIDIA NIM, OpenAI-compatible) ----------
# Used by librechat.yaml as ${SHAVI_AI_KEY}. Server-side only.
SHAVI_AI_KEY=CHANGE_ME_NVIDIA_API_KEY

# ---------- accounts ----------
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false
SESSION_EXPIRY=900000

# ---------- RAG (file uploads / document Q&A) ----------
RAG_PORT=8000
RAG_API_URL=http://rag_api:8000

# ---------- docker ----------
# Use `id -u` and `id -g` of the deploying user.
UID=1000
GID=1000

# Required to stop LibreChat's scheduler warning on single-replica installs.
SCHEDULES_SINGLE_PROCESS=true
