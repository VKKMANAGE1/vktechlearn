# SHAVI AI on LibreChat — environment template (no real secrets here).
# Copy to .env and fill every CHANGE_ME value. .env must never be committed.
#
# Generate secrets:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   # CREDS_KEY / JWT_*
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"   # CREDS_IV
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" # MEILI_MASTER_KEY

# ---------- HTTPS / domains (M12) ----------
# Both hostnames must resolve to this host before `docker compose up`; Caddy issues and
# renews the certificates for them, and is the only service exposed to the internet.
SHAVI_DOMAIN=CHANGE_ME_chat.example.com
SHAVI_ADMIN_DOMAIN=CHANGE_ME_admin.example.com
ACME_EMAIL=CHANGE_ME_you@example.com

# ---------- server ----------
HOST=0.0.0.0
PORT=3080
APP_TITLE=SHAVI AI
# Replaces LibreChat's default footer line.
CUSTOM_FOOTER=SHAVI AI — Made by Vïnâý Kúshwâhå · © 2026 VK Tech Learn
# Must match the public HTTPS origin, otherwise login cookies and CORS are rejected.
DOMAIN_CLIENT=https://CHANGE_ME_chat.example.com
DOMAIN_SERVER=https://CHANGE_ME_chat.example.com
# LibreChat's Settings → "Admin panel" link points at the panel gateway (M11).
ADMIN_PANEL_URL=https://CHANGE_ME_admin.example.com

# ---------- rate limits (M11: LibreChat ships message limiting disabled) ----------
LIMIT_MESSAGE_USER=true
LIMIT_MESSAGE_IP=true
MESSAGE_USER_MAX=40
MESSAGE_USER_WINDOW=1
MESSAGE_IP_MAX=60
MESSAGE_IP_WINDOW=1

# ---------- backups (M12) ----------
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=7
PGVECTOR_PASSWORD=CHANGE_ME_pg_password

# ---------- database ----------
MONGO_URI=mongodb://mongodb:27017/LibreChat

# ---------- secrets (CHANGE_ME) ----------
CREDS_KEY=CHANGE_ME_64_HEX_CHARS
CREDS_IV=CHANGE_ME_32_HEX_CHARS
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_64_HEX_CHARS
MEILI_MASTER_KEY=CHANGE_ME_BASE64
MEILI_HOST=http://meilisearch:7700

# ---------- AI provider (NVIDIA NIM, OpenAI-compatible) ----------
# Used by librechat.yaml as ${SHAVI_AI_KEY}. Server-side only.
SHAVI_AI_KEY=CHANGE_ME_NVIDIA_API_KEY
# Official provider keys (server-side only). One per enabled provider.
OPENAI_API_KEY=CHANGE_ME_OPENAI_KEY
DEEPSEEK_API_KEY=CHANGE_ME_DEEPSEEK_KEY
GOOGLE_KEY=CHANGE_ME_GEMINI_KEY

# ---------- accounts ----------
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false
SESSION_EXPIRY=900000

# ---------- RAG (file uploads / document Q&A) ----------
RAG_PORT=8000
RAG_API_URL=http://rag_api:8000

# ---------- docker ----------
# Use `id -u` and `id -g` of the deploying user.
UID=1000
GID=1000

# Required to stop LibreChat's scheduler warning on single-replica installs.
SCHEDULES_SINGLE_PROCESS=true
